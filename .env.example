# ── Jira Configuration ──────────────────────────────────────
# URL is required for Jira tools
JIRA_URL=https://your-company.atlassian.net

# Option 1: Basic auth (Jira Cloud — recommended)
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your_api_token

# Option 2: Personal access token (Jira Data Center / self-hosted)
# JIRA_PAT=your-personal-access-token
# Also accepts: JIRA_PERSONAL_TOKEN, JIRA_TOKEN

# ── Confluence Configuration ───────────────────────────────
# URL is required for Confluence tools
CONFLUENCE_URL=https://your-company.atlassian.net/wiki

# Option 1: Basic auth (Confluence Cloud — recommended)
CONFLUENCE_USERNAME=your.email@company.com
CONFLUENCE_API_TOKEN=your_api_token

# Option 2: Personal access token (Confluence Data Center / self-hosted)
# CONFLUENCE_PAT=your-personal-access-token
# Also accepts: CONFLUENCE_PERSONAL_TOKEN, CONFLUENCE_TOKEN

# ── Optional ───────────────────────────────────────────────
# Lock the server read-only. MCP_READ_ONLY is the shared name across the mcp-* servers;
# ATLASSIAN_READ_ONLY is the per-server alias. Either being truthy locks it and nothing
# turns it back off at runtime. Set it in a launch the deployer owns to actually enforce it.
# MCP_READ_ONLY=false
# ATLASSIAN_READ_ONLY=false
